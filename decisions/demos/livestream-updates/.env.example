# Every demo in the deck calls live services. Set to 1 after you configure them.
SLIDEV_ENABLE_LIVE=0
# Set to 1 to let the Run button on slide 7 execute the editor's
# Python in a local isolated process.
SLIDEV_ENABLE_CODE_RUN=0

# Decisions and Responses model calls (including Monaco Run).
# Use the resource root, not /openai/v1 or a Foundry project URL.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Entra: leave empty and sign in with az login --tenant <your-tenant-id>.
# API key: set your resource key here instead. A nonempty key takes precedence;
# a failed key request does not retry with Entra. Never put keys in VITE_*.
AZURE_OPENAI_API_KEY=
# Use your deployment name, which can differ from the model name.
DECISIONS_DEPLOYMENT=gpt-6-luna
# System 2 lane on slide 8 (Responses API, reasoning effort high).
# Defaults to RESPONSES_DEPLOYMENT, then DECISIONS_DEPLOYMENT.
# SYSTEM2_DEPLOYMENT=gpt-6-luna

# Optional Microsoft-Decision-1 panel (separate REST contract).
# Deploy Microsoft-Decision-1 on a Foundry resource first. Use its deployment
# name, not the model ID unless you deliberately gave the deployment that name.
# A blank endpoint reuses AZURE_OPENAI_ENDPOINT (only if the deployment is there).
SYSTEMONE_ENDPOINT=
SYSTEMONE_DEPLOYMENT=
# Absent: reuse AZURE_OPENAI_API_KEY. Empty: use Entra even if OpenAI uses a key.
# Uncomment to select a separate resource key or explicit Entra authentication.
# SYSTEMONE_API_KEY=

# Optional OBO demo: delegated Entra user sign-in is required, even when model
# calls use an API key. A model key cannot replace user identity or consent.
# Provision with ..\agent-obo-tools\agent_obo_factory.py.
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AGENT_NAME=obo-demo-agent
TENANT_ID=
CLIENT_APP_ID=
AGENT_BLUEPRINT_CLIENT_ID=
# Leave empty to derive from the project endpoint and agent name.
AGENT_OPENAI_BASE_URL=
# Only these product-owned HTTPS consent hosts can be opened from the deck.
OBO_CONSENT_HOSTS=consent.azure-apim.net
