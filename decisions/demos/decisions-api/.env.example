# Azure OpenAI resource in a region that has gpt-6-luna (Decisions is not in East US 2 yet)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Optional. Leave empty to use Microsoft Entra ID (DefaultAzureCredential).
AZURE_OPENAI_API_KEY=

# Deployment name of the gpt-6-luna model (the only model that supports Decisions)
DECISIONS_DEPLOYMENT=gpt-6-luna
# Deployment used for the latency comparison with the Responses API
RESPONSES_DEPLOYMENT=gpt-6-luna

# Optional. Local path or public HTTPS URL of a delivery photo for step 6
DEMO_IMAGE=

# Optional. Sends traces to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
