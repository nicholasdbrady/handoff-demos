AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5-mini
AGENT_NAME=obo-demo-agent

# ── Tool connection (authType = AgentOnBehalfOfUser) ──
# Work IQ MCP project connection (the endpoint documented by Microsoft Learn)
CONNECTION_NAME=workiq-mcp-obo
MCP_SERVER_URL=https://workiq.svc.cloud.microsoft/mcp
MCP_SERVER_LABEL=workiq
# Fully qualified delegated scopes for ONE resource, comma-separated. No ".default".
OBO_SCOPES=api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask

# Only for --create-connection (ARM). Otherwise create the connection in the portal.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
CONNECTION_API_VERSION=2026-09-01

# ── Caller (user sign-in) ──
TENANT_ID=
# Public client app registration with redirect URI http://localhost and the access_agent permission
CLIENT_APP_ID=
# Printed by agent_obo_factory.py
AGENT_BLUEPRINT_CLIENT_ID=
# Optional. Defaults to <project-endpoint>/agents/<agent>/endpoint/protocols/openai/
AGENT_OPENAI_BASE_URL=

APPLICATIONINSIGHTS_CONNECTION_STRING=
