# Copy to .env beside demo_server.py. Keep .env out of Git.
# Static slides and captured/illustrative panels need no credentials.
# Live calls can incur Azure charges. Enable only after each demo's prerequisites.
SLIDEV_ENABLE_LIVE=0

# Agent Framework demo: project endpoint and deployed model name.
# Sign in with Azure CLI before enabling live.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-5.4-mini

# azd prepared hosted-agent invocation. Azure CLI Entra authentication required.
AZD_AGENT_PROJECT_ENDPOINT=
AZD_AGENT_NAME=

# fal: do not enable until an administrator reviews terms and deployment access.
FOUNDRY_RESOURCE_ENDPOINT=
FAL_ACCESS_CONFIRMED=false
FAL_DEPLOYMENTS={"ltx-2.5-fast":"","ltx-2.5-pro":"","minimax-h3-max":"","minimax-h3-max-turbo":"","kling-v3-pro":""}
# Only independently confirmed USD per generated VIDEO SECOND. No pricing default.
FAL_PRICES_PER_SECOND_USD={}

# Kimi Chat Completions endpoint; include /openai/v1/.
KIMI_ENDPOINT=
KIMI_DEPLOYMENT=kimi-k3-1-pro
KIMI_AUTH=cli

# Never use VITE_ for a key, token, or endpoint containing credentials.
# Azure identity, quota, regions, fal terms/access, azd >=1.37, and tool setup
# must be configured separately. An empty configuration keeps slides usable.
