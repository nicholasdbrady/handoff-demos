  "answer": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Cobalt Orbit \u2014 Kinetic Sculpture</title>\n<style>\n  :root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n  *{box-sizing:border-box}\n  html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#050b17;color:#eef5ff}\n  body{position:relative}\n  #stage,canvas{position:absolute;inset:0;width:100%;height:100%}\n  canvas{display:block;cursor:grab;touch-action:none;outline-offset:-4px}\n  canvas.dragging{cursor:grabbing}\n  header{position:absolute;z-index:2;top:28px;left:32px;pointer-events:none;text-shadow:0 2px 18px #020610}\n  .kicker{margin:0 0 7px;color:#efba8e;font-size:16px;font-weight:650;letter-spacing:.18em;text-transform:uppercase}\n  h1{margin:0;font-size:clamp(28px,3vw,46px);font-weight:520;letter-spacing:-.035em;line-height:1.05}\n  .subtitle{margin:10px 0 0;color:#bfd0e6;font-size:16px;letter-spacing:.02em}\n  .hint{position:absolute;z-index:2;right:26px;top:28px;padding:9px 13px;border:1px solid #2b405d;border-radius:999px;background:#07111ecf;color:#c4d5e9;font-size:16px;pointer-events:none}\n  .controls{position:absolute;z-index:3;left:50%;bottom:24px;transform:translateX(-50%);display:flex;align-items:center;gap:12px;width:max-content;max-width:calc(100% - 32px);padding:12px;border:1px solid #344d6c;border-radius:16px;background:#081321ed;box-shadow:0 12px 40px #0007;backdrop-filter:blur(12px)}\n  button{min-height:46px;padding:0 18px;border:1px solid #476181;border-radius:10px;background:#12243a;color:#f2f7ff;font:inherit;font-size:16px;font-weight:650;cursor:pointer}\n  button:hover{background:#1b324f;border-color:#7994b6}\n  #toggle{background:#b9784f;border-color:#dcaa83;color:#09101c}\n  #toggle:hover{background:#d09264}\n  :focus-visible{outline:3px solid #ffd09f;outline-offset:3px}\n  .speed{width:210px;padding:0 7px}\n  .speed label{display:flex;justify-content:space-between;gap:14px;margin-bottom:5px;color:#dbe7f5;font-size:16px}\n  output{color:#efba8e;font-variant-numeric:tabular-nums}\n  input[type=range]{display:block;width:100%;height:24px;margin:0;accent-color:#e0a477;cursor:pointer}\n  #error{position:absolute;z-index:10;inset:0;display:grid;place-content:center;padding:32px;background:#050b17;text-align:center}\n  #error[hidden]{display:none}\n  #error h2{margin:0 0 12px;color:#ffd0ae;font-size:28px}\n  #error p{max-width:560px;margin:0;color:#e3ecf7;font-size:18px;line-height:1.6}\n  @media(max-width:700px){\n    header{top:18px;left:18px}.hint{display:none}.subtitle{max-width:260px}\n    .controls{bottom:12px;flex-wrap:wrap;justify-content:center;gap:9px;width:calc(100% - 24px);padding:10px}\n    .speed{order:3;flex:1 1 100%;width:auto;max-width:380px}.speed label{margin-bottom:0}\n    button{flex:1;padding:0 12px}\n  }\n</style>\n</head>\n<body>\n<main id=\"stage\" aria-label=\"Interactive three-dimensional kinetic sculpture\"></main>\n<header>\n  <p class=\"kicker\">Kinetic study \u00b7 No. 03</p>\n  <h1>Cobalt Orbit</h1>\n  <p class=\"subtitle\">A luminous heart, held in motion.</p>\n</header>\n<div class=\"hint\">Drag to orbit \u00b7 Scroll to zoom</div>\n<section class=\"controls\" aria-label=\"Sculpture controls\">\n  <button id=\"toggle\" type=\"button\" aria-pressed=\"false\">Pause</button>\n  <div class=\"speed\">\n    <label for=\"speed\">Motion speed <output id=\"speedValue\" for=\"speed\">1.0\u00d7</output></label>\n    <input id=\"speed\" type=\"range\" min=\"0\" max=\"2\" step=\"0.1\" value=\"1\" aria-label=\"Motion speed\">\n  </div>\n  <button id=\"reset\" type=\"button\">Reset view</button>\n</section>\n<div id=\"error\" role=\"alert\" hidden>\n  <h2>WebGL is unavailable</h2>\n  <p id=\"errorText\">This sculpture needs WebGL. Enable hardware acceleration or open this page in a WebGL-capable browser.</p>\n</div>\n<script src=\"./vendor/three.min.js\"></script>\n<script>\n(() => {\n  'use strict';\n  const stage=document.getElementById('stage'), toggle=document.getElementById('toggle');\n  const speedInput=document.getElementById('speed'), speedValue=document.getElementById('speedValue');\n  const errorBox=document.getElementById('error');\n  let failed=false;\n  function fail(message){\n    failed=true; errorBox.hidden=false;\n    if(message) document.getElementById('errorText').textContent=message;\n    document.querySelectorAll('button,input').forEach(el=>el.disabled=true);\n    document.querySelector('.controls').style.display='none';\n  }\n  if(!window.THREE){fail('The local three.js library could not be loaded, and WebGL cannot be started. Check that ./vendor/three.min.js is available.');return;}\n  let renderer;\n  try{renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});}\n  catch(e){fail();return;}\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));\n  renderer.outputColorSpace=THREE.SRGBColorSpace;\n  renderer.toneMapping=THREE.ACESFilmicToneMapping;\n  renderer.toneMappingExposure=1.02;\n  renderer.setClearColor(0x050b17);\n  const canvas=renderer.domElement;\n  canvas.tabIndex=0;\n  canvas.setAttribute('aria-label','Cobalt Orbit. Drag or use arrow keys to orbit, mouse wheel or plus and minus to zoom, and Home to reset the view.');\n  stage.appendChild(canvas);\n  canvas.addEventListener('webglcontextlost',e=>{e.preventDefault();fail('The WebGL context was lost. Reload this page to restore the sculpture.');});\n\n  const scene=new THREE.Scene();\n  scene.background=new THREE.Color(0x050b17);\n  scene.fog=new THREE.Fog(0x050b17,11,25);\n  const camera=new THREE.PerspectiveCamera(42,1,.1,60);\n  const target=new THREE.Vector3(0,-.12,0);\n  scene.add(new THREE.HemisphereLight(0x91b5ed,0x111525,1.15));\n  const key=new THREE.DirectionalLight(0xdceaff,2.8); key.position.set(4,7,6); scene.add(key);\n  const warm=new THREE.DirectionalLight(0xffb782,2.1); warm.position.set(-5,2,3); scene.add(warm);\n  const rim=new THREE.DirectionalLight(0x477cff,2.4); rim.position.set(2,1,-6); scene.add(rim);\n  const coreLight=new THREE.PointLight(0x1755ff,10,6,2); scene.add(coreLight);\n\n  const sculpture=new THREE.Group(); scene.add(sculpture);\n  const steel=new THREE.MeshStandardMaterial({color:0x91a8bd,metalness:.82,roughness:.28});\n  const copper=new THREE.MeshStandardMaterial({color:0xc27c50,metalness:.78,roughness:.3});\n  const coreMat=new THREE.MeshStandardMaterial({color:0x074bd8,emissive:0x073dff,emissiveIntensity:2.25,metalness:.3,roughness:.2});\n  const core=new THREE.Mesh(new THREE.SphereGeometry(.56,48,32),coreMat); sculpture.add(core);\n  const halo=new THREE.Mesh(new THREE.SphereGeometry(.7,32,24),new THREE.MeshBasicMaterial({color:0x286dff,transparent:true,opacity:.075,depthWrite:false,side:THREE.BackSide}));\n  sculpture.add(halo);\n\n  const specs=[\n    {r:1.7,tube:.037,rot:[.52,.2,.25],spin:.16,rate:.38},\n    {r:2.3,tube:.031,rot:[1.22,-.35,-.42],spin:-.115,rate:-.27},\n    {r:2.88,tube:.027,rot:[.28,1.02,.18],spin:.075,rate:.19}\n  ];\n  const spinners=[],frames=[],beadGeometry=new THREE.SphereGeometry(.075,12,8),dummy=new THREE.Object3D();\n  specs.forEach((s,i)=>{\n    const pivot=new THREE.Group(); pivot.rotation.set(...s.rot); sculpture.add(pivot);\n    const spinner=new THREE.Group(); pivot.add(spinner); spinners.push(spinner);\n    frames.push(new THREE.Matrix4().makeRotationFromEuler(new THREE.Euler(...s.rot)));\n    const mat=i===1?copper:steel;\n    spinner.add(new THREE.Mesh(new THREE.TorusGeometry(s.r,s.tube,10,192),mat));\n    const path=[];\n    for(let j=0;j<192;j++){const a=j/192*Math.PI*2;path.push(new THREE.Vector3(Math.cos(a)*(s.r+.105),Math.sin(a)*(s.r+.105),0));}\n    const line=new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(path),new THREE.LineBasicMaterial({color:i===1?0xc58257:0x517fb3,transparent:true,opacity:.22}));\n    spinner.add(line);\n    const beads=new THREE.InstancedMesh(beadGeometry,copper,6);\n    for(let j=0;j<6;j++){\n      const a=j/6*Math.PI*2+i*.37;\n      dummy.position.set(Math.cos(a)*s.r,Math.sin(a)*s.r,0);\n      dummy.scale.setScalar(j%3===0?1.25:.7); dummy.updateMatrix(); beads.setMatrixAt(j,dummy.matrix);\n    }\n    spinner.add(beads);\n  });\n\n  const floor=new THREE.Mesh(new THREE.CircleGeometry(8,96),new THREE.MeshStandardMaterial({color:0x091423,metalness:.15,roughness:.92}));\n  floor.rotation.x=-Math.PI/2; floor.position.y=-3.4; scene.add(floor);\n  const plinth=new THREE.Mesh(new THREE.CylinderGeometry(3.48,3.68,.32,96),new THREE.MeshStandardMaterial({color:0x182638,metalness:.55,roughness:.52}));\n  plinth.position.y=-3.22; scene.add(plinth);\n  const trim=new THREE.Mesh(new THREE.TorusGeometry(3.49,.018,8,128),copper);\n  trim.rotation.x=Math.PI/2; trim.position.y=-3.07; scene.add(trim);\n  const stem=new THREE.Mesh(new THREE.CylinderGeometry(.022,.04,2.5,12),copper); stem.position.y=-1.8; scene.add(stem);\n  const socket=new THREE.Mesh(new THREE.CylinderGeometry(.17,.22,.14,32),copper); socket.position.y=-3; scene.add(socket);\n\n  const dotCanvas=document.createElement('canvas'); dotCanvas.width=dotCanvas.height=32;\n  const ctx=dotCanvas.getContext('2d'),gradient=ctx.createRadialGradient(16,16,0,16,16,16);\n  gradient.addColorStop(0,'rgba(255,255,255,1)'); gradient.addColorStop(.25,'rgba(255,255,255,.9)'); gradient.addColorStop(1,'rgba(255,255,255,0)');\n  ctx.fillStyle=gradient; ctx.fillRect(0,0,32,32);\n  const COUNT=840,positions=new Float32Array(COUNT*3),colors=new Float32Array(COUNT*3);\n  const phases=new Float32Array(COUNT),radii=new Float32Array(COUNT),depths=new Float32Array(COUNT);\n  let seed=4817; function random(){seed=(seed*16807)%2147483647;return(seed-1)/2147483646;}\n  const blue=new THREE.Color(0x74a7ff),amber=new THREE.Color(0xf0a36c),v=new THREE.Vector3();\n  for(let i=0;i<COUNT;i++){\n    const band=i%3; phases[i]=random()*Math.PI*2;\n    radii[i]=specs[band].r+(random()-.5)*.19; depths[i]=(random()-.5)*.07;\n    const c=(band===1?amber:blue).clone().multiplyScalar(.65+random()*.35);\n    colors.set([c.r,c.g,c.b],i*3);\n  }\n  const particleGeometry=new THREE.BufferGeometry();\n  particleGeometry.setAttribute('position',new THREE.BufferAttribute(positions,3).setUsage(THREE.DynamicDrawUsage));\n  particleGeometry.setAttribute('color',new THREE.BufferAttribute(colors,3));\n  const particles=new THREE.Points(particleGeometry,new THREE.PointsMaterial({size:.052,map:new THREE.CanvasTexture(dotCanvas),vertexColors:true,transparent:true,opacity:.82,depthWrite:false,blending:THREE.AdditiveBlending}));\n  sculpture.add(particles);\n\n  let theta=.55,phi=1.18,dist=10.8,fit=1,dragging=false,lastX=0,lastY=0;\n  let paused=window.matchMedia('(prefers-reduced-motion: reduce)').matches,speed=1,time=.8;\n  function updateCamera(){\n    camera.position.set(dist*Math.sin(phi)*Math.sin(theta),dist*Math.cos(phi),dist*Math.sin(phi)*Math.cos(theta)).add(target);\n    camera.lookAt(target);\n  }\n  function resetView(){theta=.55;phi=1.18;dist=10.8*fit;updateCamera();}\n  function resize(){\n    const oldFit=fit,w=innerWidth,h=innerHeight;\n    camera.aspect=w/h; fit=Math.max(1,1/camera.aspect); dist=dist/oldFit*fit;\n    camera.updateProjectionMatrix(); renderer.setSize(w,h,false); updateCamera();\n  }\n  function syncPause(){toggle.textContent=paused?'Resume':'Pause';toggle.setAttribute('aria-pressed',String(paused));}\n  toggle.addEventListener('click',()=>{paused=!paused;syncPause();});\n  document.getElementById('reset').addEventListener('click',resetView);\n  speedInput.addEventListener('input',()=>{speed=Number(speedInput.value);speedValue.value=speed.toFixed(1)+'\u00d7';speedInput.setAttribute('aria-valuetext',speed.toFixed(1)+' times');});\n  canvas.addEventListener('pointerdown',e=>{dragging=true;lastX=e.clientX;lastY=e.clientY;canvas.setPointerCapture(e.pointerId);canvas.classList.add('dragging');canvas.focus({preventScroll:true});});\n  canvas.addEventListener('pointermove',e=>{\n    if(!dragging)return;\n    theta-=(e.clientX-lastX)*.005; phi=Math.max(.28,Math.min(2.72,phi-(e.clientY-lastY)*.005));\n    lastX=e.clientX;lastY=e.clientY;updateCamera();\n  });\n  function endDrag(){dragging=false;canvas.classList.remove('dragging');}\n  canvas.addEventListener('pointerup',endDrag); canvas.addEventListener('pointercancel',endDrag);\n  canvas.addEventListener('wheel',e=>{e.preventDefault();dist=Math.max(7*fit,Math.min(16*fit,dist*Math.exp(e.deltaY*.001)));updateCamera();},{passive:false});\n  canvas.addEventListener('keydown',e=>{\n    let used=true;\n    if(e.key==='ArrowLeft')theta-=.09;else if(e.key==='ArrowRight')theta+=.09;\n    else if(e.key==='ArrowUp')phi=Math.max(.28,phi-.08);else if(e.key==='ArrowDown')phi=Math.min(2.72,phi+.08);\n    else if(e.key==='+'||e.key==='=')dist=Math.max(7*fit,dist*.93);else if(e.key==='-')dist=Math.min(16*fit,dist*1.07);\n    else if(e.key==='Home')resetView();else used=false;\n    if(used){e.preventDefault();updateCamera();}\n  });\n  addEventListener('resize',resize); resize(); resetView(); syncPause();\n\n  let previous=performance.now();\n  function frame(now){\n    if(failed)return;\n    requestAnimationFrame(frame);\n    const dt=Math.min((now-previous)/1000,.04); previous=now;\n    if(!paused)time+=dt*speed;\n    sculpture.rotation.y=.08+time*.035;\n    spinners.forEach((s,i)=>s.rotation.z=time*specs[i].spin);\n    core.scale.setScalar(1+Math.sin(time*1.35)*.025);\n    halo.material.opacity=.065+Math.sin(time*1.35)*.012;\n    coreLight.intensity=9+Math.sin(time*1.35)*.7;\n    for(let i=0;i<COUNT;i++){\n      const band=i%3,a=phases[i]+time*specs[band].rate,r=radii[i];\n      v.set(Math.cos(a)*r,Math.sin(a)*r,depths[i]).applyMatrix4(frames[band]);\n      positions[i*3]=v.x;positions[i*3+1]=v.y;positions[i*3+2]=v.z;\n    }\n    particleGeometry.attributes.position.needsUpdate=true;\n    renderer.render(scene,camera);\n  }\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>",
