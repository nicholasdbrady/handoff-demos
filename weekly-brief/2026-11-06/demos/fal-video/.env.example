# Server-side only. Copy to .env (gitignored). Never use VITE_ names.
FOUNDRY_RESOURCE_ENDPOINT=https://your-resource.services.ai.azure.com
# Show resource: https://handoff-fal-20261109.services.ai.azure.com
# Set true only when fal is registered on the subscription and deployments exist.
FAL_ACCESS_CONFIRMED=false
# Exact deployment names. Show resource names are listed in the README.
FAL_DEPLOYMENTS={"minimax-h3-max-turbo":"","ltx-2.5-fast":"","ltx-2.5-pro":"","minimax-h3-max":"","kling-v3-pro":""}
# USD per generated video second at the runner's settings. Missing = blocked.
# Retail meters ('Azure Fal', unit '1 Second') match the launch table for LTX/MiniMax.
FAL_PRICES_PER_SECOND_USD={}
# Show values (480P/720p, audio off for Kling):
# FAL_PRICES_PER_SECOND_USD={"minimax-h3-max-turbo":0.025,"ltx-2.5-fast":0.09,"ltx-2.5-pro":0.12,"minimax-h3-max":0.05,"kling-v3-pro":0.1232}
